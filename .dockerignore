# Keep the build context to the locked runtime inputs.
**
!Dockerfile
!.dockerignore
!pyproject.toml
!uv.lock
!src/
!src/**

# Explicitly exclude local/private material even if a future allowlist changes.
.git
.env
.env.*
**/.env
**/.env.*
.aws
credentials
*.pem
*.key
.codegraph
.terraform
**/.terraform
*.tfstate
*.tfstate.*
*.tfplan
tests
artifacts
data
cache
**/cache
.venv
venv
__pycache__
**/__pycache__
*.py[cod]
.pytest_cache
.mypy_cache
.ruff_cache
.coverage
htmlcov
